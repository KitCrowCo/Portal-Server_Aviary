{
 "name": "Make an image",
 "group": "images",
 "objective": "An image from a prompt. A kept prompt that was encoded before (same text and length) is painted from its kept encoding, with no encoder needed; otherwise it is encoded first (once: the same text, encoder and length is found again) and the encoding is noted on the kept prompt. The painter makes the image and the file is brought into a space's folder.",
 "about": [
  "prompt_text"
 ],
 "roles": {
  "encoder": {
   "needs": [
    "text_encode"
   ],
   "about": "the encoder model and the machine that encodes - only when the prompt has no encoding yet for this text and length (step kept). A run that finds one never places or loads it."
  },
  "painter": {
   "needs": [
    "image_generate"
   ],
   "about": "the image model and the machine that paints"
  }
 },
 "params": {
  "saved": {
   "label": "Kept prompt",
   "pick": "image_prompt",
   "default": "",
   "hint": "One of Sunbird's kept prompts (Sunbird, Prompts)."
  },
  "prompt": {
   "label": "Words added after the kept prompt",
   "type": "long",
   "default": "",
   "hint": "Optional. With a kept prompt chosen, these are added after it (and it is encoded again, since the text is new). Without one, they are the whole prompt."
  },
  "width": {
   "label": "Width",
   "type": "integer",
   "default": 1024
  },
  "height": {
   "label": "Height",
   "type": "integer",
   "default": 1024
  },
  "steps": {
   "label": "Steps",
   "type": "integer",
   "default": 4
  },
  "guidance": {
   "label": "Guidance",
   "type": "number",
   "default": 1.0
  },
  "seed": {
   "label": "Seed (-1: a new one each time)",
   "type": "integer",
   "default": -1
  },
  "loras": {
   "label": "LoRAs, each at its own strength",
   "pick_assets": "image_lora",
   "strengths": true,
   "default": {},
   "hint": "A strength beside each LoRA the machines offer (the files in a machine's image models, lora/flux2): empty or 0 leaves it out, 1 is its full effect. At most three are used at once."
  },
  "space": {
   "label": "Kept in",
   "pick": "space",
   "default": "media"
  },
  "folder": {
   "label": "Folder there",
   "default": "images"
  },
  "max_len": {
   "label": "Prompt tokens kept",
   "type": "integer",
   "default": 512,
   "hint": "Longer prompts are cut here at encoding."
  },
  "truncate": {
   "label": "Cut a longer prompt",
   "type": "boolean",
   "default": true
  },
  "shift": {
   "label": "Shift (empty: the model's own)",
   "type": "number",
   "default": null
  },
  "offload": {
   "label": "Memory saving",
   "pick_from": [
    [
     "none",
     "none (fastest, most memory)"
    ],
    [
     "vae_cpu",
     "decoder on the processor (about 1 GB less)"
    ],
    [
     "sequential",
     "block by block (slowest, least memory)"
    ]
   ],
   "default": "none",
   "hint": "What the painter keeps on the graphics side while it works. When a run ends with \"out of memory\", take the next heavier one."
  },
  "vae_tiling": {
   "label": "Decode in tiles",
   "type": "boolean",
   "default": true
  }
 },
 "steps": [
  {
   "id": "words",
   "type": "texts",
   "needs": [
    "saved",
    "prompt"
   ],
   "gives": [
    "prompt_text"
   ],
   "config": {
    "kind": "image_prompt",
    "ids": "{saved}",
    "after": "{prompt}",
    "join": "\n",
    "give": "prompt_text"
   }
  },
  {
   "id": "kept",
   "type": "kept_encoding",
   "needs": [
    "saved",
    "prompt_text",
    "max_len"
   ],
   "gives": [
    "kept_embed",
    "kept_at"
   ],
   "config": {
    "kind": "image_prompt",
    "id": "{saved}",
    "text": "{prompt_text}",
    "max_len": "{max_len}",
    "give": {
     "kept_embed": "embed",
     "kept_at": "at"
    }
   }
  },
  {
   "id": "choose",
   "type": "expr",
   "needs": [
    "kept_embed"
   ],
   "gives": [
    "go_kept",
    "go_new"
   ],
   "config": {
    "expr": "'kept' if kept_embed else 'new'",
    "routes": {
     "kept": "go_kept",
     "new": "go_new"
    }
   }
  },
  {
   "id": "use",
   "type": "expr",
   "needs": [
    "go_kept",
    "kept_embed"
   ],
   "gives": [
    "embed"
   ],
   "config": {
    "expr": "kept_embed",
    "give": "embed"
   }
  },
  {
   "id": "use_at",
   "type": "expr",
   "needs": [
    "go_kept",
    "kept_at"
   ],
   "gives": [
    "embed_at"
   ],
   "config": {
    "expr": "kept_at",
    "give": "embed_at"
   }
  },
  {
   "id": "encode",
   "type": "capability",
   "needs": [
    "go_new",
    "prompt_text",
    "max_len",
    "truncate"
   ],
   "gives": [
    "embed",
    "encoded",
    "embed_at",
    "encoder"
   ],
   "config": {
    "role": "encoder",
    "capability": "text_encode",
    "body": {
     "prompt": "{prompt_text}",
     "max_sequence_length": "{max_len}",
     "hard_truncate": "{truncate}"
    },
    "give": {
     "embed": "result.job_id",
     "encoded": "result.meta",
     "embed_at": "provider",
     "encoder": "asset"
    }
   }
  },
  {
   "id": "record",
   "type": "expr",
   "needs": [
    "encoded",
    "saved",
    "prompt"
   ],
   "gives": [
    "record"
   ],
   "config": {
    "expr": "bool(saved) and not str(prompt or '').strip()",
    "give": "record"
   }
  },
  {
   "id": "note",
   "type": "lib_note",
   "needs": [
    "record",
    "embed",
    "embed_at",
    "encoder",
    "encoded",
    "max_len",
    "prompt_text",
    "saved"
   ],
   "gives": [
    "noted"
   ],
   "config": {
    "kind": "image_prompt",
    "id": "{saved}",
    "field": "encodings",
    "when": "record",
    "same": [
     "at",
     "encoder",
     "max_len",
     "text"
    ],
    "record": {
     "embed": "{embed}",
     "at": "{embed_at}",
     "encoder": "{encoder}",
     "max_len": "{max_len}",
     "tokens": "{encoded}",
     "text": "{prompt_text}"
    },
    "give": "noted"
   }
  },
  {
   "id": "carry",
   "type": "carry",
   "needs": [
    "embed",
    "embed_at"
   ],
   "gives": [
    "carried"
   ],
   "config": {
    "from_at": "{embed_at}",
    "to": "painter",
    "location": "vault",
    "path": "jobs/{embed}",
    "give": "carried"
   }
  },
  {
   "id": "lora_list",
   "type": "expr",
   "needs": [
    "loras"
   ],
   "gives": [
    "lora_list"
   ],
   "config": {
    "expr": "[{'path': n, 'scale': float(s)} for n, s in loras.items() if s and float(s)] if isinstance(loras, dict) else [{'path': n, 'scale': 1.0} for n in loras or []]",
    "give": "lora_list"
   }
  },
  {
   "id": "paint",
   "type": "capability",
   "once": true,
   "needs": [
    "embed",
    "prompt_text",
    "width",
    "height",
    "steps",
    "guidance",
    "seed",
    "lora_list",
    "carried",
    "shift",
    "offload",
    "vae_tiling"
   ],
   "gives": [
    "file_name"
   ],
   "config": {
    "role": "painter",
    "capability": "image_generate",
    "detached": true,
    "body": {
     "prompt": "{prompt_text}",
     "embed_job_id": "{embed}",
     "width": "{width}",
     "height": "{height}",
     "steps": "{steps}",
     "guidance_scale": "{guidance}",
     "seed": "{seed}",
     "loras": "{lora_list}",
     "shift": "{shift}",
     "offload_mode": "{offload}",
     "vae_tiling": "{vae_tiling}"
    },
    "give": {
     "file_name": "result.file_name"
    }
   }
  },
  {
   "id": "bring",
   "type": "fetch",
   "needs": [
    "file_name",
    "space",
    "folder"
   ],
   "gives": [
    "image"
   ],
   "config": {
    "role": "painter",
    "location": "outputs",
    "path": "{file_name}",
    "space": "{space}",
    "into": "{folder}",
    "give": "image"
   }
  }
 ]
}
